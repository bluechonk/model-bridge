{
  "name": "modelmux",
  "version": "0.1.0",
  "type": "module",
  "description": "多渠道本地模型池网关 CLI：多个渠道汇成一个 OpenAI 兼容端点，只对外暴露两个池内模型",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "modelmux": "./dist/cli.bundle.js",
    "mx": "./dist/cli.bundle.js"
  },
  "files": [
    "dist/cli.bundle.js"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
